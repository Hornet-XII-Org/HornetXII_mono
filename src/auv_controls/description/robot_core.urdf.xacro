<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="inertial_macros.urdf.xacro"/>

    <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
    </material>
    
    <material name="blue">        
        <color rgba="0.0 0.0 1.0 1.0"/>
    </material>


    <joint name="thruster_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="thruster"/>
        <axis xyz="1.0 0.0 0.0"/>
        <!-- <limit effort="10.0" velocity="100.0"/> -->
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz= "0 0 0" rpy = "0 0 0"/>
            <geometry>
                <box size="0.2 0.2 0.2"/>
            </geometry>
            <material name="red"/>
        </visual>     
        
        <collision>
            <origin xyz= "0 0 0" rpy = "0 0 0"/>
            <geometry>
                <box size="0.2 0.2 0.2"/>
            </geometry>            
        </collision>

        <xacro:inertial_box mass="4" x="0.2" y="0.2" z="0.2">
            <origin xyz= "0 0 0" rpy = "0 0 0"/>
        </xacro:inertial_box>
    </link>

    <link name="thruster">
        <visual>
            <origin xyz="0.25 0 0" rpy="0 ${-pi/2} 0"/>
            <geometry>                
                <cylinder radius="0.1" length="0.1"/>                
            </geometry>
            <material name="blue"/>                    
        </visual>
        <xacro:inertial_box mass="0.01" x="0.001" y="0.001" z="0.001">
            <origin xyz= "0 0 0" rpy = "0 0 0"/>
        </xacro:inertial_box>
    </link>
</robot>