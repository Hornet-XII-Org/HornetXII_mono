<?xml version="1.0"?>
<sdf version="1.9">
  <model name="sauvc_gate">
    <static>true</static>
    <link name="gate">
      <visual name="left_post">
        <pose>0 -0.8 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.1 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0.4 0 1</ambient>
          <diffuse>1 0.4 0 1</diffuse>
        </material>
      </visual>

      <visual name="right_post">
        <pose>0 0.8 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.1 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0.4 0 1</ambient>
          <diffuse>1 0.4 0 1</diffuse>
        </material>
      </visual>

      <visual name="top_bar">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 1.7 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0.4 0 1</ambient>
          <diffuse>1 0.4 0 1</diffuse>
        </material>
      </visual>
      <!-- Model origin is the opening center. Inner width 1.5 m, top at
           +0.5 m, post bottoms at -0.5 m; there is no bottom crossbar. -->
      <collision name="left_post_collision">
        <pose>0 -0.8 0 0 0 0</pose>
        <geometry><box><size>0.1 0.1 1.0</size></box></geometry>
      </collision>
      <collision name="right_post_collision">
        <pose>0 0.8 0 0 0 0</pose>
        <geometry><box><size>0.1 0.1 1.0</size></box></geometry>
      </collision>
      <collision name="top_bar_collision">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry><box><size>0.1 1.7 0.1</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
