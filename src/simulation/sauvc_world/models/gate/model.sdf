<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Mesh from 3d_pool_props.zip (150 x 100 cm). Height is stretched x1.5 (mesh-Y
       scale 0.015) to the 150 x 150 cm finals navigation gate of the SAUVC 2027
       rulebook v2027.3.2; the posts are only ~4 cm wide so the stretch is harmless.
        Source units are cm (scale 0.01) and the
       mesh is Y-up, so it is rolled 90 deg about X (and yawed 90 deg so the flat face looks down the pool, +x). Model origin = bottom
       centre of the object, so spawn z = height of the object's base. -->
  <model name="sauvc_gate">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <pose>0 0 0 1.5707963 0 1.5707963</pose>
        <geometry>
          <mesh>
            <uri>model://gate/meshes/competition-gate.obj</uri>
            <scale>0.01 0.015 0.01</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
