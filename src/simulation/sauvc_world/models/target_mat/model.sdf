<?xml version="1.0"?>
<sdf version="1.9">
  <!-- SAUVC finals target zone: green mat, 8 m x 2 m, lying on the pool floor.
       Origin = centre of the mat's top face, so spawn z = floor height. -->
  <model name="target_mat">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <pose>0 0 -0.005 0 0 0</pose>
        <geometry><box><size>8.0 2.0 0.01</size></box></geometry>
        <material>
          <ambient>0.1 0.55 0.2 1</ambient>
          <diffuse>0.1 0.55 0.2 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
